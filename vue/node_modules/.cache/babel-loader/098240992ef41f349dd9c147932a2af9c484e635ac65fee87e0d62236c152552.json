{"ast":null,"code":"import request from \"@/utils/request\";\nexport default {\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('userInfo') || '{}'),\n      pageNum: 1,\n      pageSize: 6,\n      form: {},\n      tableData: {},\n      search: {}\n    };\n  },\n  created() {},\n  methods: {\n    loadDate() {\n      if (this.search.content == null) {\n        request.get('/cert/carts', {\n          params: {\n            pageNum: this.pageNum,\n            pageSize: this.pageSize\n          }\n        }).then(res => {\n          if (res.code === '0') {\n            console.log(res.data);\n            this.tableData = res.data.list;\n            this.total = res.data.total;\n          }\n        });\n      }\n    },\n    update() {\n      // 保存当前的用户信息到数据库\n      request.post('/user/update', this.user).then(res => {\n        if (res.code === '0') {\n          // 成功更新\n          this.$message.success('保存成功');\n          // 更新浏览器缓存里的用户信息\n          localStorage.setItem('userInfo', JSON.stringify(this.user));\n\n          // 触发父级的数据更新\n          this.$emit('update:user');\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    handleAvatarSuccess(response) {\n      // 把user的头像属性换成上传的图片的链接\n      this.$set(this.user, 'avatar', response.data);\n    },\n    del(id) {\n      this.$confirm('您确定删除吗？', '确认删除', {\n        type: \"warning\"\n      }).then(response => {\n        request.delete('/cert/delete/' + id).then(res => {\n          if (res.code === '0') {\n            // 表示操作成功\n            this.$message.success('操作成功');\n            this.loadData();\n          } else {\n            this.$message.error(res.msg); // 弹出错误的信息\n          }\n        });\n      }).catch(() => {});\n    }\n  }\n};","map":{"version":3,"names":["request","data","user","JSON","parse","localStorage","getItem","pageNum","pageSize","form","tableData","search","created","methods","loadDate","content","get","params","then","res","code","console","log","list","total","update","post","$message","success","setItem","stringify","$emit","error","msg","handleAvatarSuccess","response","$set","del","id","$confirm","type","delete","loadData","catch"],"sources":["src/views/front/center/Cart.vue"],"sourcesContent":["\r\n<template>\r\n  <div>\r\n    <div class=\"userInfo-card\">\r\n      <div class=\"search\">\r\n        <el-input  class=\"search-input\"  placeholder=\"请输入书名\" suffix-icon=\"el-icon-search\"></el-input>\r\n        <el-button type=\"primary\" class=\"search-button\">搜索</el-button>\r\n        <el-button type=\"warning\">重置</el-button>\r\n      </div>\r\n\r\n      <el-card>\r\n        <el-table\r\n            :data=\"tableData\"\r\n            :header-cell-style=\"{'text-align':'center'}\"\r\n            :cell-style=\"{'text-align':'center'}\"\r\n            style=\"width: 100%\">\r\n          <el-table-column prop=\"id\" label=\"ID\" width=\"50\"></el-table-column>\r\n          <el-table-column prop=\"pic\" label=\"封面\" >\r\n            <template slot-scope=\"scope\">\r\n              <img :src=\"scope.row.pic\"\r\n                   style=\"width: 60px; height: 80px; object-fit: cover; border-radius: 4px;\"\r\n                   alt=\"封面图片\">\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"name\" label=\"书名\" ></el-table-column>\r\n          <el-table-column prop=\"author\" label=\"作者\"> </el-table-column>\r\n          <el-table-column prop=\"num\" label=\"数量\">\r\n            <el-input-number :min=\"1\" :max=\"99\"></el-input-number>\r\n          </el-table-column>\r\n        </el-table>\r\n        <!--分页-->\r\n        <div  class=\"pagination-div\">\r\n          <el-pagination\r\n              background\r\n              @current-change=\"handleCurrentChange\"\r\n              :current-page=\"pageNum\"\r\n              :page-sizes=\"[5, 10, 20]\"\r\n              :page-size=\"pageSize\"\r\n              layout=\"total, prev, pager, next\"\r\n              :total=\"total\">\r\n          </el-pagination>\r\n        </div>\r\n      </el-card>\r\n    </div>\r\n    <div class=\"out-table\">\r\n      <el-button type=\"warning\">全部购买</el-button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport request from \"@/utils/request\";\r\n\r\nexport default {\r\n  data() {\r\n\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('userInfo') || '{}'),\r\n      pageNum:1,\r\n      pageSize:6,\r\n      form: {},\r\n      tableData: {},\r\n      search:{}\r\n    }\r\n  },\r\n  created() {\r\n\r\n  },\r\n  methods: {\r\n\r\n    loadDate(){\r\n      if (this.search.content == null){\r\n        request.get('/cert/carts', {\r\n          params:{\r\n            pageNum:this.pageNum,\r\n            pageSize: this.pageSize,\r\n          }\r\n        }).then(res =>{\r\n          if (res.code === '0'){\r\n            console.log(res.data);\r\n            this.tableData = res.data.list;\r\n            this.total = res.data.total\r\n          }\r\n        })\r\n      }\r\n    },\r\n\r\n    update() {\r\n      // 保存当前的用户信息到数据库\r\n      request.post('/user/update', this.user).then(res => {\r\n        if (res.code === '0') {\r\n          // 成功更新\r\n          this.$message.success('保存成功')\r\n          // 更新浏览器缓存里的用户信息\r\n          localStorage.setItem('userInfo', JSON.stringify(this.user))\r\n\r\n          // 触发父级的数据更新\r\n          this.$emit('update:user')\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    handleAvatarSuccess(response) {\r\n      // 把user的头像属性换成上传的图片的链接\r\n      this.$set(this.user, 'avatar', response.data)\r\n    },\r\n\r\n    del(id){\r\n      this.$confirm('您确定删除吗？', '确认删除', {type: \"warning\"}).then(response => {\r\n        request.delete('/cert/delete/' + id).then(res => {\r\n          if (res.code === '0') {   // 表示操作成功\r\n            this.$message.success('操作成功')\r\n            this.loadData()\r\n          } else {\r\n            this.$message.error(res.msg)  // 弹出错误的信息\r\n          }\r\n        })\r\n      })\r\n          .catch(()=>{})\r\n    },\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.out-table{\r\n  display: flex;\r\n  justify-content: end;\r\n}\r\n</style>"],"mappings":"AAmDA,OAAAA,OAAA;AAEA;EACAC,KAAA;IAEA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA;MACAC,QAAA;MACAC,IAAA;MACAC,SAAA;MACAC,MAAA;IACA;EACA;EACAC,QAAA,GAEA;EACAC,OAAA;IAEAC,SAAA;MACA,SAAAH,MAAA,CAAAI,OAAA;QACAf,OAAA,CAAAgB,GAAA;UACAC,MAAA;YACAV,OAAA,OAAAA,OAAA;YACAC,QAAA,OAAAA;UACA;QACA,GAAAU,IAAA,CAAAC,GAAA;UACA,IAAAA,GAAA,CAAAC,IAAA;YACAC,OAAA,CAAAC,GAAA,CAAAH,GAAA,CAAAlB,IAAA;YACA,KAAAS,SAAA,GAAAS,GAAA,CAAAlB,IAAA,CAAAsB,IAAA;YACA,KAAAC,KAAA,GAAAL,GAAA,CAAAlB,IAAA,CAAAuB,KAAA;UACA;QACA;MACA;IACA;IAEAC,OAAA;MACA;MACAzB,OAAA,CAAA0B,IAAA,sBAAAxB,IAAA,EAAAgB,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA;UACA,KAAAO,QAAA,CAAAC,OAAA;UACA;UACAvB,YAAA,CAAAwB,OAAA,aAAA1B,IAAA,CAAA2B,SAAA,MAAA5B,IAAA;;UAEA;UACA,KAAA6B,KAAA;QACA;UACA,KAAAJ,QAAA,CAAAK,KAAA,CAAAb,GAAA,CAAAc,GAAA;QACA;MACA;IACA;IACAC,oBAAAC,QAAA;MACA;MACA,KAAAC,IAAA,MAAAlC,IAAA,YAAAiC,QAAA,CAAAlC,IAAA;IACA;IAEAoC,IAAAC,EAAA;MACA,KAAAC,QAAA;QAAAC,IAAA;MAAA,GAAAtB,IAAA,CAAAiB,QAAA;QACAnC,OAAA,CAAAyC,MAAA,mBAAAH,EAAA,EAAApB,IAAA,CAAAC,GAAA;UACA,IAAAA,GAAA,CAAAC,IAAA;YAAA;YACA,KAAAO,QAAA,CAAAC,OAAA;YACA,KAAAc,QAAA;UACA;YACA,KAAAf,QAAA,CAAAK,KAAA,CAAAb,GAAA,CAAAc,GAAA;UACA;QACA;MACA,GACAU,KAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}